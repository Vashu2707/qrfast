datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Tenancy ────────────────────────────────────────────────────────────────
// One Postgres, one deployment. Each restaurant/hotel owns a Tenant row and
// every business row carries tenantId. The two fixed IDs below are the
// pre-existing properties; all old rows are backfilled to them so the app
// keeps working while scoping is phased in.

enum TenantKind {
  RESTAURANT
  HOTEL
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  kind      TenantKind
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  adminUsers     AdminUser[]
  settings       Settings[]
  tables         Table[]
  categories     Category[]
  menuItems      MenuItem[]
  variants       Variant[]
  addons         Addon[]
  orders         Order[]
  orderItems     OrderItem[]
  payments       Payment[]
  offers         Offer[]
  reviews        Review[]
  notifications  Notification[]
  invoices       Invoice[]
  hotelUsers     HotelUser[]
  hotelSettings  HotelSettings[]
  hotelRoomTypes HotelRoomType[]
  hotelRooms     HotelRoom[]
  hotelBookings  HotelBooking[]
}

enum Role {
  ADMIN
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  PREPARED
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
}

enum NotificationType {
  NEW_ORDER
  PAYMENT
  CALL_WAITER
  REQUEST_BILL
  KITCHEN_READY
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum FoodType {
  VEG
  NON_VEG
  VEGAN
}

model AdminUser {
  id        String   @id // Matches Supabase Auth User ID (UUID)
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  tenantId  String   @default("11111111-1111-1111-1111-111111111111")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MenuSection {
  FOOD
  COCKTAIL
}

model Settings {
  id                      String   @id @default("singleton")
  tenantId                String   @unique @default("11111111-1111-1111-1111-111111111111")
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  restaurantName          String   @default("My Restaurant")
  cocktailsEnabled        Boolean  @default(false)
  logo                    String?
  banner                  String?
  address                 String?
  phone                   String?
  email                   String?
  primaryColor            String   @default("#E11D48")
  currency                String   @default("INR")
  timezone                String   @default("Asia/Kolkata")
  gstNumber               String?
  gstPercentage           Decimal  @default(5.0) @db.Decimal(5, 2)
  serviceChargePercentage Decimal  @default(0.0) @db.Decimal(5, 2)
  openingHours            Json?
  socialLinks             Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Table {
  id              String      @id @default(uuid())
  number          String
  tenantId        String      @default("11111111-1111-1111-1111-111111111111")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  qrCodeUrl       String?
  status          TableStatus @default(AVAILABLE)
  // Bumped when staff regenerate a table's QR code. Tokens carry the
  // generation they were issued for; a rotated table rejects older tokens.
  tokenGeneration Int         @default(1)
  orders          Order[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tenantId, number])
}

model Category {
  id          String      @id @default(uuid())
  name        String
  tenantId    String      @default("11111111-1111-1111-1111-111111111111")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  description String?
  image       String?
  section     MenuSection @default(FOOD)
  sortOrder   Int         @default(0)
  parentId    String?
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]  @relation("CategoryTree")
  menuItems   MenuItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, name, parentId])
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  tenantId        String      @default("11111111-1111-1111-1111-111111111111")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  discountPrice   Decimal?    @db.Decimal(10, 2)
  foodType        FoodType    @default(VEG)
  spicyLevel      Int         @default(0)
  preparationTime Int         @default(15)
  images          String[]
  isAvailable     Boolean     @default(true)
  isChefSpecial   Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  ingredients     String[]
  allergens       String[]
  nutrition       Json?
  // Cocktail-only drink attributes (null on food items — both sections share
  // this table; Category.section already separates the two trees)
  abv             Decimal?    @db.Decimal(5, 2)
  baseSpirit      String?
  glass           String?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants        Variant[]
  addons          Addon[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Variant {
  id         String   @id @default(uuid())
  tenantId   String   @default("11111111-1111-1111-1111-111111111111")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Addon {
  id         String   @id @default(uuid())
  tenantId   String   @default("11111111-1111-1111-1111-111111111111")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  isVeg      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                  String        @id @default(uuid())
  tableId             String
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  tenantId            String        @default("11111111-1111-1111-1111-111111111111")
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerName        String
  customerPhone       String
  status              OrderStatus   @default(PLACED)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(CASH)
  subtotal            Decimal       @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0.0) @db.Decimal(10, 2)
  gstAmount           Decimal       @default(0.0) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.0) @db.Decimal(10, 2)
  totalAmount         Decimal       @db.Decimal(10, 2)
  offerCode           String?
  notes               String?
  orderItems          OrderItem[]
  payments            Payment[]
  reviews             Review[]
  invoices            Invoice[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model OrderItem {
  id             String   @id @default(uuid())
  tenantId       String   @default("11111111-1111-1111-1111-111111111111")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity       Int
  price          Decimal  @db.Decimal(10, 2)
  notes          String?
  customizations Json?
  createdAt      DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String        @default("11111111-1111-1111-1111-111111111111")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  transactionId String?
  paymentId     String?
  signature     String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Offer {
  id             String       @id @default(uuid())
  tenantId       String       @default("11111111-1111-1111-1111-111111111111")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code           String
  title          String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0.0) @db.Decimal(10, 2)
  expiryDate     DateTime
  usageLimit     Int?
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, code])
}

model Review {
  id           String    @id @default(uuid())
  tenantId     String    @default("11111111-1111-1111-1111-111111111111")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int
  comment      String?
  images       String[]
  adminReply   String?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String           @default("11111111-1111-1111-1111-111111111111")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Invoice {
  id             String   @id @default(uuid())
  tenantId       String   @default("11111111-1111-1111-1111-111111111111")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  pdfUrl         String?
  amount         Decimal  @db.Decimal(10, 2)
  taxAmount      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([tenantId, invoiceNumber])
}

// ─── Hotel space (separate tables from the restaurant space) ─────────────────

enum HotelRole {
  ADMIN
  STAFF
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum HotelPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model HotelUser {
  id        String    @id // Matches Supabase Auth User ID (UUID)
  email     String    @unique
  name      String?
  role      HotelRole @default(ADMIN)
  tenantId  String    @default("22222222-2222-2222-2222-222222222222")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model HotelSettings {
  id            String   @id @default("singleton")
  tenantId      String   @unique @default("22222222-2222-2222-2222-222222222222")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hotelName     String   @default("My Hotel")
  logo          String?
  banner        String?
  description   String?
  address       String?
  phone         String?
  email         String?
  primaryColor  String   @default("#0F172A")
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  gstPercentage Decimal  @default(0.0) @db.Decimal(5, 2)
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("11:00")
  openingHours  Json?
  socialLinks   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HotelRoomType {
  id          String         @id @default(uuid())
  tenantId    String         @default("22222222-2222-2222-2222-222222222222")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  basePrice   Decimal        @db.Decimal(10, 2)
  maxGuests   Int            @default(2)
  amenities   String[]
  images      String[]
  sortOrder   Int            @default(0)
  rooms       HotelRoom[]
  bookings    HotelBooking[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, name])
}

model HotelRoom {
  id         String         @id @default(uuid())
  tenantId   String         @default("22222222-2222-2222-2222-222222222222")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  number     String
  floor      String?
  status     RoomStatus     @default(AVAILABLE)
  roomTypeId String
  roomType   HotelRoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings   HotelBooking[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([tenantId, number])
}

model HotelBooking {
  id              String             @id @default(uuid())
  tenantId        String             @default("22222222-2222-2222-2222-222222222222")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  referenceCode   String
  guestName       String
  guestEmail      String?
  guestPhone      String
  guestCount      Int                @default(1)
  roomTypeId      String
  roomType        HotelRoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomId          String?
  room            HotelRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  checkInDate     DateTime
  checkOutDate    DateTime
  status          BookingStatus      @default(CONFIRMED)
  paymentStatus   HotelPaymentStatus @default(PENDING)
  paymentMethod   String?
  totalAmount     Decimal            @db.Decimal(10, 2)
  specialRequests String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, referenceCode])
}
