datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  KITCHEN
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
}

enum NotificationType {
  NEW_ORDER
  PAYMENT
  CALL_WAITER
  REQUEST_BILL
  KITCHEN_READY
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Restaurant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  logo          String?
  banner        String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean        @default(true)
  users         User[]
  tables        Table[]
  categories    Category[]
  menuItems     MenuItem[]
  orders        Order[]
  coupons       Coupon[]
  notifications Notification[]
  settings      Settings?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id           String      @id // Matches Supabase Auth User ID (UUID)
  email        String      @unique
  name         String?
  role         Role        @default(ADMIN)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Settings {
  id                      String     @id @default(uuid())
  restaurantId            String     @unique
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  primaryColor            String     @default("#E11D48") // Rose 600
  currency                String     @default("INR")
  timezone                String     @default("Asia/Kolkata")
  gstNumber               String?
  gstPercentage           Float      @default(5.0)
  serviceChargePercentage Float      @default(0.0)
  businessHours           Json?
  updatedAt               DateTime   @updatedAt
}

model Table {
  id           String      @id @default(uuid())
  number       String
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCodeUrl    String?
  status       TableStatus @default(AVAILABLE)
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, number])
}

model Category {
  id           String     @id @default(uuid())
  name         String
  description  String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Float
  discountPrice   Float?
  isVeg           Boolean     @default(true)
  spicyLevel      Int         @default(0) // 0 = none, 1 = mild, 2 = medium, 3 = hot
  preparationTime Int         @default(15) // in minutes
  images          String[]
  isAvailable     Boolean     @default(true)
  ingredients     String[]
  allergens       String[]
  nutrition       Json?       // calories, protein, carbs, fat
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  variants        Variant[]
  addons          Addon[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Variant {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g. Regular, Large
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Addon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g. Extra Cheese
  price      Float
  isVeg      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                  String        @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId             String
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  status              OrderStatus   @default(PLACED)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(CASH)
  subtotal            Float
  discountAmount      Float         @default(0.0)
  gstAmount           Float         @default(0.0)
  serviceChargeAmount Float         @default(0.0)
  totalAmount         Float
  couponCode          String?
  notes               String?
  orderItems          OrderItem[]
  payments            Payment[]
  reviews             Review[]
  invoices            Invoice[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity       Int
  price          Float
  notes          String?
  customizations Json?    // Stores selected variant and addons as snapshot
  createdAt      DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  method        PaymentMethod
  transactionId String?       // Razorpay order ID
  paymentId     String?       // Razorpay payment ID
  signature     String?       // Razorpay verification signature
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Coupon {
  id            String       @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code          String
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderAmount Float       @default(0.0)
  expiryDate    DateTime
  usageLimit    Int?
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([restaurantId, code])
}

model Review {
  id           String    @id @default(uuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int       // 1 to 5
  comment      String?
  images       String[]
  adminReply   String?
  createdAt    DateTime  @default(now())
}

model Notification {
  id           String           @id @default(uuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  message      String
  type         NotificationType
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  pdfUrl        String?
  amount        Float
  taxAmount     Float
  discountAmount Float
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
